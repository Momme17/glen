---
import { getCollection, render } from 'astro:content';
import Rubrik from './Rubrik.astro';

const poster = (await getCollection('instruktorer')).sort(
  (a, b) => a.data.ordning - b.data.ordning,
);

const instruktorer = await Promise.all(
  poster.map(async (post) => ({
    ...post,
    Bio: (await render(post)).Content,
  })),
);
---

<section id="instruktorer" class="bg-bone-dim py-[var(--spacing-section)]">
  <div class="shell">
    <Rubrik etikett="Tränarteamet">
      Instruktörer
      <p slot="under">
        Alla våra tränare är utbildade och engagerade i klubben på ideell basis.
        Tränare som arbetar med barn och ungdomar lämnar löpande in polisutdrag.
      </p>
    </Rubrik>

    <ul
      class="mt-14 grid gap-px border border-bone-line bg-bone-line sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        instruktorer.map(({ id, data, Bio }) => (
          <li class="flex flex-col bg-bone p-7">
            <div class="mb-5 flex items-center gap-4">
              {data.foto ? (
                <img
                  src={data.foto}
                  alt={data.fotoAlt || `Porträtt av ${data.namn}`}
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                  class="h-18 w-18 shrink-0 object-cover"
                />
              ) : (
                <span
                  class="flex h-16 w-16 shrink-0 items-center justify-center bg-ink font-display text-2xl text-brass-bright"
                  aria-hidden="true"
                >
                  {data.namn.charAt(0)}
                </span>
              )}
              <div>
                <h3 class="text-h3">{data.namn}</h3>
                <p class="mt-1 text-sm text-ink/60">{data.roll}</p>
              </div>
            </div>

            <div class="prose-bfc text-[0.95rem] text-ink/75">
              <Bio />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
